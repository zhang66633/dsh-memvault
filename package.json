{
  "name": "dsh-memvault",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: inject MemVault core memory blocks into the system prompt and hand every Nth finished turn to MemVault's extraction pipeline",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./blocks": "./lib/blocks.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "smoke:extract": "node scripts/smoke-extract.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test": "node scripts/smoke-package.mjs && node scripts/smoke.mjs && node scripts/smoke-extract.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang66633/dsh-memvault.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memvault",
    "memory",
    "long-term-memory",
    "core-memory",
    "system-prompt",
    "context-injection",
    "sqlite",
    "mcp"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.1 <0.2.0-0"
  },
  "license": "MIT"
}
