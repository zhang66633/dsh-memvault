{
  "name": "dsh-memvault",
  "version": "0.6.0",
  "description": "DeepSeek Harness plugin: inject MemVault core memory blocks into the system prompt, extract finished turns as one windowed pass, and show and edit both in a memory panel — all knobs described by a config schema",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./blocks": "./lib/blocks.js",
    "./panel": "./lib/panel.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:config": "node scripts/smoke-config.mjs",
    "smoke:extract": "node scripts/smoke-extract.mjs",
    "smoke:panel": "node scripts/smoke-panel.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test": "node scripts/smoke-package.mjs && node scripts/smoke-config.mjs && node scripts/smoke.mjs && node scripts/smoke-extract.mjs && node scripts/smoke-panel.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang66633/dsh-memvault.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memvault",
    "memory",
    "long-term-memory",
    "core-memory",
    "system-prompt",
    "context-injection",
    "kv-cache",
    "sqlite",
    "mcp",
    "panel"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "license": "MIT"
}
